config DESKTOP_BLE_STATE
	bool "Bluetooth LE state module"
	help
	  Enable the Bluetooth LE state module.
	  By default nRF Desktop uses the Bluetooth LE state module from Common Application
	  Framework (CAF).
	  An alternative, application-specific implementation is available which
	  is selected by enabling the CONFIG_DESKTOP_BLE_STATE_APP_SPECIFIC option.

config DESKTOP_BLE_STATE_CAF
	bool
	depends on DESKTOP_BLE_STATE
	depends on !DESKTOP_BLE_STATE_APP_SPECIFIC
	default y
	select CAF_BLE_STATE
	help
	  An alternative, application-specific implementation is available which
	  is selected by enabling the CONFIG_DESKTOP_BLE_STATE_APP_SPECIFIC option.

config DESKTOP_BLE_STATE_APP_SPECIFIC
	bool "Bluetooth LE state module (app-specific) [EXPERIMENTAL]"
	depends on DESKTOP_BLE_STATE
	depends on BT
	depends on BT_SMP
	select CAF_BLE_COMMON_EVENTS
	select CAF_BLE_STATE_SUPPORTED
	select EXPERIMENTAL
	help
	  Enable app-specific implementation of Bluetooth LE state module.
	  The module enables Bluetooth, handles Zephyr's connection callbacks,
	  propagates information about the connection state and parameters by
	  using Application Event Manager events and exchanges GATT MTU on GATT
	  Client.

if DESKTOP_BLE_STATE_APP_SPECIFIC

config DESKTOP_BLE_STATE_MODULE_SUSPEND_EVENTS
	bool "Module suspend/resume request events support"
	depends on CAF_MODULE_SUSPEND_EVENTS
	depends on DESKTOP_BT_PERIPHERAL
	default y
	help
	  Allow suspending and resuming the module at runtime using CAF module
	  suspend and resume request events.
	  Currently supported only for nRF Desktop peripheral configurations.

config DESKTOP_BLE_STATE_FREE_HW_RESOURCES_ON_SUSPEND
	bool "Free allocated HW resources on suspend to allow radio reuse"
	depends on DESKTOP_BLE_STATE_MODULE_SUSPEND_EVENTS
	depends on BT_LL_SOFTDEVICE
	select BT_UNINIT_MPSL_ON_DISABLE
	select MPSL_DYNAMIC_INTERRUPTS
	select DYNAMIC_DIRECT_INTERRUPTS
	select DYNAMIC_INTERRUPTS
	help
	  Free allocated hardware resources when module is suspended to allow
	  reusing radio e.g. to communicate over another wireless protocol.
	  The resources are freed on bt_disable call.

config DESKTOP_BLE_STATE_SECURITY_REQ
	bool "Request connection encryption (security level 2)"
	help
	  Automatically request connection encryption right after the connection is established.

config DESKTOP_BLE_STATE_PM
	bool "Bluetooth LE power manager integration"
	depends on CAF_POWER_MANAGER
	select CAF_KEEP_ALIVE_EVENTS
	default y
	help
	  This enables small module that keeps track on active connections.
	  The version of the module from the NCS CAF subsystem is reused.
	  If there is any active connection the power down modes would be limited to SUSPENDED.
	  Full POWER OFF mode would be only allowed if we have no active connection.

config DESKTOP_BLE_STATE_EXCHANGE_MTU
	bool "Exchange MTU"
	depends on BT_GATT_CLIENT
	default y
	help
	  Use the bt_gatt_exchange_mtu to set the MTU to the maximum possible size the buffers can
	  hold.

config DESKTOP_BLE_USE_LLPM
	bool "Low Latency Packet Mode (LLPM)"
	depends on (BT_CTLR_SDC_LLPM || !HAS_BT_CTLR)
	default y if HAS_BT_CTLR
	help
	  LLPM is a proprietary Bluetooth extension from Nordic Semiconductor. It is designed for
	  applications in which the interface response time is critical for the user. It introduces
	  the possibility to reduce the connection interval to 1 ms for one link. LLPM parameters
	  can be used for a given connection only if it's supported by both peripheral and central.

	  By default, if using the Bluetooth LE state module version from CAF
	  (CONFIG_DESKTOP_BLE_STATE_CAF enabled), the option is still present, but it's promptless
	  and mirrors the value of the CONFIG_CAF_BLE_USE_LLPM.
	  This is needed as the option is used also by application modules other than BLE state.

config DESKTOP_BLE_STATE_MAX_LOCAL_ID_BONDS
	int "Number of allowed bonds per Bluetooth local identity"
	depends on BT_PERIPHERAL
	range 1 BT_MAX_PAIRED
	default 1
	help
	  The available Bluetooth bonds are shared among Bluetooth local
	  identities. Limiting number of bonds allowed per local identity
	  prevents from situation where one local identity uses too many bonds.
	  In that case, other local identities may be unable to bond.

	  By default, if using the Bluetooth LE state module version from CAF
	  (CONFIG_DESKTOP_BLE_STATE_CAF enabled), the option is still present, but it's promptless
	  and mirrors the value of the CONFIG_CAF_BLE_STATE_MAX_LOCAL_ID_BONDS.
	  This is needed as the option is used also by application modules other than BLE state.

config DESKTOP_BLE_STATE_MAX_LOCAL_ID_BONDS
	depends on !BT_PERIPHERAL
	default 0

module = DESKTOP_BLE_STATE
module-str = Bluetooth LE state
source "subsys/logging/Kconfig.template.log_config"

endif # DESKTOP_BLE_STATE_APP_SPECIFIC

if DESKTOP_BLE_STATE_CAF

config DESKTOP_BLE_USE_LLPM
	bool
	default y if CAF_BLE_USE_LLPM
	help
	  If using the Bluetooth LE state module version from CAF
	  (CONFIG_DESKTOP_BLE_STATE_CAF enabled), the option is still present, but it's promptless
	  and mirrors the value of the CONFIG_CAF_BLE_USE_LLPM.
	  This is needed as the option is used also by application modules other than BLE state.

config DESKTOP_BLE_STATE_MAX_LOCAL_ID_BONDS
	int
	default CAF_BLE_STATE_MAX_LOCAL_ID_BONDS
	help
	  If using the Bluetooth LE state module version from CAF
	  (CONFIG_DESKTOP_BLE_STATE_CAF enabled), the option is still present, but it's promptless
	  and mirrors the value of the CONFIG_CAF_BLE_STATE_MAX_LOCAL_ID_BONDS.
	  This is needed as the option is used also by application modules other than BLE state.

config DESKTOP_BLE_STATE_MAX_LOCAL_ID_BONDS
	depends on !BT_PERIPHERAL
	default 0

endif # DESKTOP_BLE_STATE_CAF
